<Window x:Class="JuninComercial.Desktop.Views.CountriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Países" Height="450" Width="600">
    <DockPanel>
        <!-- Equivalente al <top><HBox> de country.fxml -->
        <Border DockPanel.Dock="Top" Padding="15,12">
            <TextBlock Text="Países" FontSize="20" FontWeight="Bold"/>
        </Border>

        <!-- Equivalente al <bottom><HBox> de country.fxml -->
        <Border DockPanel.Dock="Bottom" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Volver" Padding="12,4" Margin="0,0,10,0" Click="BtnVolver_Click"/>
                <Button Content="Nuevo" Padding="12,4" Margin="0,0,10,0" Click="BtnNuevo_Click"/>
                <Button Content="Editar" Padding="12,4" Margin="0,0,10,0" Click="BtnEditar_Click"/>
                <Button Content="Eliminar" Padding="12,4" Click="BtnEliminar_Click"/>
            </StackPanel>
        </Border>

        <!-- Equivalente al <center><TableView> de country.fxml -->
        <DataGrid x:Name="Table" Margin="15" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Width="300" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Código" Width="120" Binding="{Binding Code}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
